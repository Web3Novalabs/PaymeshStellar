NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database — PostgreSQL connection string (required for DB operations)
# Docker quick-start: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 postgres:16
DATABASE_URL=postgresql://user:password@localhost:5432/paymesh

# Auth
JWT_SECRET=your-secret-key-min-32-chars
# Access JWT lifetime, in seconds. Defaults to 900 (15m).
ACCESS_TOKEN_TTL_SECONDS=900
# Opaque rotating refresh-token lifetime, in seconds. Defaults to 2592000 (30d).
REFRESH_TOKEN_TTL_SECONDS=2592000
# Wallet auth challenge (nonce) lifetime, in seconds. Defaults to 300 (5m) if unset.
CHALLENGE_TTL_SECONDS=300
# Interval for deleting old challenge/session rows. Defaults to 3600 (1h).
AUTH_CLEANUP_INTERVAL_SECONDS=3600

# Stellar / Horizon
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=Test SDF Network ; September 2015
STELLAR_SIGNING_SECRET=S...
STELLAR_HOME_DOMAIN=paymesh.example
STELLAR_WEB_AUTH_DOMAIN=api.paymesh.example
HORIZON_TIMEOUT=30000
HORIZON_CACHE_TTL=30000

LOG_LEVEL=debug

# Soroban
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
AUTOSHARE_CONTRACT_ID=C...

# On-chain event indexer (pnpm backend:indexer / pnpm backend:backfill)
CONTRACT_ID=C...
# Cold-start ledger, and the fallback used when the stored cursor is found to be
# outside the RPC's retention window. Pick a ledger no older than your RPC's
# retention (commonly ~7 days of history on public RPC providers).
INDEXER_START_LEDGER=1
# Delay between polls once the worker has caught up with the chain tip, in ms.
INDEXER_POLL_INTERVAL_MS=5000
# Max events requested per getEvents call.
INDEXER_PAGE_LIMIT=100
# How long SIGTERM/SIGINT wait for an in-flight batch to finish before forcing exit, in ms.
INDEXER_SHUTDOWN_GRACE_MS=30000
# Ceiling for the exponential backoff applied after a transient RPC/DB error, in ms.
INDEXER_MAX_RETRY_DELAY_MS=30000
