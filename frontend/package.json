    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "9.1.0",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
